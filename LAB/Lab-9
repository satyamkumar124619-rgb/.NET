@model Placement_Dashboard.Models.DashboardViewModel
@{
    ViewData["Title"] = "Placement Dashboard";
}

<div class="dashboard-container">
    <h1 class="mb-4">Student Placement Dashboard</h1>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stats-card h-100">
                <div class="card-body">
                    <div class="label">Total Students</div>
                    <div class="value">@Model.TotalStudents</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stats-card h-100">
                <div class="card-body">
                    <div class="label">Students Placed</div>
                    <div class="value">@Model.PlacedStudents</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stats-card h-100">
                <div class="card-body">
                    <div class="label">Companies</div>
                    <div class="value">@Model.CompaniesCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stats-card h-100">
                <div class="card-body">
                    <div class="label">Placement Rate</div>
                    <div class="value">@Model.PlacementRate.ToString("0.0")%</div>
                </div>
            </div>
        </div>
    </div>

    <div class="filters mb-3 d-flex gap-2 align-items-center">
        <form method="get" asp-controller="Home" asp-action="Index">
            <div class="input-group w-auto" style="max-width: 340px;">
                <select class="form-select" name="status" id="status">
                    <option value="All" selected="@(Model.StatusFilter == "All")">All Students</option>
                    <option value="Placed" selected="@(Model.StatusFilter == "Placed")">Placed</option>
                    <option value="Not Placed" selected="@(Model.StatusFilter == "Not Placed")">Not Placed</option>
                </select>
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
        <a asp-controller="Home" asp-action="Report" asp-route-status="@Model.StatusFilter" class="btn btn-outline-secondary">Printable Report</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Student ID</th>
                    <th>Student Name</th>
                    <th>Course</th>
                    <th>Company Name</th>
                    <th>Package</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model.Students)
                {
                    <tr>
                        <td>@student.StudentId</td>
                        <td>@student.StudentName</td>
                        <td>@student.Course</td>
                        <td>@student.CompanyName</td>
                        <td>@student.Package.ToString("0.0") LPA</td>
                        <td>@student.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

