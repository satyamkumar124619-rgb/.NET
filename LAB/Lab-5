using System;

namespace AcademicCalendarSystem
{
    public partial class AcademicCalendar : System.Web.UI.Page
    {
        protected void Page_Load(object sender, EventArgs e)
        {
            // Check Session

            if (Session["UserName"] == null)
            {
                Response.Redirect("Default.aspx");

                return;
            }


            if (!IsPostBack)
            {
                // Get Name from Session

                string name =
                    Session["UserName"].ToString();

                lblWelcome.Text =
                    "Welcome, " + name;
            }
        }


        // Calendar date selection

        protected void AcademicCalendarControl_SelectionChanged(
            object sender,
            EventArgs e)
        {
            DateTime selectedDate =
                AcademicCalendarControl.SelectedDate;


            // Show selected date

            lblSelectedDate.Text =
                "Selected Date: " +
                selectedDate.ToString("dd-MM-yyyy");


            // Store selected date in Session

            Session["SelectedDate"] =
                selectedDate;
        }


        // Apply Leave button

        protected void btnLeave_Click(
            object sender,
            EventArgs e)
        {
            // Check whether date is selected

            if (Session["SelectedDate"] == null)
            {
                lblSelectedDate.Text =
                    "Please select a date first.";

                return;
            }


            // Go to Leave Management

            Response.Redirect("LeaveManagement.aspx");
        }


        // Logout

        protected void btnLogout_Click(
            object sender,
            EventArgs e)
        {
            // Clear Session

            Session.Clear();

            Session.Abandon();


            // Go to Default page

            Response.Redirect("Default.aspx");
        }
    }
}

