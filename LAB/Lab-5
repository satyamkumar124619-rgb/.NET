using System;
using System.Data;

namespace AcademicCalendarSystem
{
    public partial class LeaveManagement : System.Web.UI.Page
    {
        protected void Page_Load(object sender, EventArgs e)
        {
            // Check User Session

            if (Session["UserName"] == null)
            {
                Response.Redirect("Default.aspx");

                return;
            }


            // Check Selected Date

            if (Session["SelectedDate"] == null)
            {
                Response.Redirect("AcademicCalendar.aspx");

                return;
            }


            if (!IsPostBack)
            {
                // Display User Name

                lblWelcome.Text =
                    "Welcome, " +
                    Session["UserName"].ToString();


                // Display Selected Date

                DateTime selectedDate =
                    (DateTime)Session["SelectedDate"];

                lblDate.Text =
                    "Selected Date: " +
                    selectedDate.ToString("dd-MM-yyyy");


                // Create Leave DataTable in Session

                if (Session["LeaveData"] == null)
                {
                    DataTable dt =
                        new DataTable();


                    dt.Columns.Add("Name");

                    dt.Columns.Add("Leave Date");

                    dt.Columns.Add("Leave Type");

                    dt.Columns.Add("Reason");


                    Session["LeaveData"] = dt;
                }


                // Show existing leaves

                LoadLeaves();
            }
        }


        // Apply Leave

        protected void btnApply_Click(
            object sender,
            EventArgs e)
        {
            // Check Reason

            if (txtReason.Text.Trim() == "")
            {
                lblMessage.Text =
                    "Please enter reason for leave.";

                return;
            }


            // Get DataTable from Session

            DataTable dt =
                (DataTable)Session["LeaveData"];


            // Create new row

            DataRow row =
                dt.NewRow();


            // Name from Session

            row["Name"] =
                Session["UserName"].ToString();


            // Date from Session

            DateTime selectedDate =
                (DateTime)Session["SelectedDate"];


            row["Leave Date"] =
                selectedDate.ToString("dd-MM-yyyy");


            // Leave Type

            row["Leave Type"] =
                ddlLeaveType.SelectedValue;


            // Reason

            row["Reason"] =
                txtReason.Text.Trim();


            // Add row

            dt.Rows.Add(row);


            // Save DataTable in Session

            Session["LeaveData"] = dt;


            // Success message

            lblMessage.Text =
                "Leave applied successfully.";


            // Clear Reason

           
 txtReason.Text = "";


            // Display leaves

            LoadLeaves();
        }


        // Load leaves into GridView

        private void LoadLeaves()
        {
            DataTable dt =
                (DataTable)Session["LeaveData"];


            gvLeaves.DataSource = dt;

            gvLeaves.DataBind();
        }


        // Back to Calendar

        protected void btnBack_Click(
            object sender,
            EventArgs e)
        {
            Response.Redirect(
                "AcademicCalendar.aspx");
        }


        // Logout

        protected void btnLogout_Click(
            object sender,
            EventArgs e)
        {
            // Clear complete Session

            Session.Clear();

            Session.Abandon();


            Response.Redirect("Default.aspx");
        }
    }
}
