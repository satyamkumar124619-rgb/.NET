using System;
using System.Web.UI;
using System.Web.UI.WebControls;
using System.Xml.Linq;

namespace OnlineEventRegistration
{
    public partial class Register : Page
    {
        protected void Page_Load(object sender, EventArgs e)
        {
            // Disable unobtrusive validation to avoid requiring a jQuery ScriptResourceMapping

            UnobtrusiveValidationMode = UnobtrusiveValidationMode.None;
        }

        protected void btnRegister_Click(object sender, EventArgs e)
        {

            if (Page.IsValid)
            {
                string name = txtName.Text.Trim();
                string email = txtEmail.Text.Trim();
                string mobile = txtMobile.Text.Trim();

                string gender = rblGender.SelectedValue;
                string eventName = ddlEvent.SelectedValue;
                string eventDate = txtDate.Text;
                string participation = rblParticipation.SelectedValue;
                string comments = txtComments.Text.Trim();

                lblMessage.Text =
                    "Registration Successful!<br/><br/>" +
                    "Name: " + Server.HtmlEncode(name) + "<br/>" +
                    "Email: " + Server.HtmlEncode(email) + "<br/>" +
                    "Mobile: " + Server.HtmlEncode(mobile) + "<br/>" +
                    "Gender: " + Server.HtmlEncode(gender) + "<br/>" +
                    "Event: " + Server.HtmlEncode(eventName) + "<br/>" +
                    "Date: " + Server.HtmlEncode(eventDate) + "<br/>" +
                    "Participation: " + Server.HtmlEncode(participation) + "<br/>" +
                    "Comments: " + Server.HtmlEncode(comments);
            }
        }

        protected void cvTerms_ServerValidate(
            object source,
            ServerValidateEventArgs args)
        {
            args.IsValid = chkTerms.Checked;
        }
    }
}
