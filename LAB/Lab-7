@model IEnumerable<FeedbackManagement.Models.Feedback>

@{
    ViewBag.Title = "Feedback List";
}

<h2>Feedback List</h2>

<p>
    @Html.ActionLink(
        "Give Feedback",
        "Create",
        "Feedback",
        null,
        new { @class = "btn btn-primary" }
    )
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No feedback available.
    </div>
}
else
{
    <table class="table table-bordered">

        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Rating</th>
            <th>Comments</th>
            <th>Date</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Rating / 5</td>
                <td>@item.Comments</td>
                <td>@item.SubmittedOn</td>
            </tr>
        }

    </table>
}
