using System;
using System.Configuration;
using System.Data;
using System.Data.SqlClient;
using System.Globalization;
using System.Web;
using System.Web.UI;

namespace InventoryManagement
{
    public partial class _Default : Page
    {
        private readonly string cs = ConfigurationManager
            .ConnectionStrings["InventoryDB"]
            .ConnectionString;

        private static bool dbReady = false;

        // Creates InventoryDB and the Products table (with sample rows) if missing.
        void EnsureDatabase()
        {
            if (dbReady) return;

            var builder = new SqlConnectionStringBuilder(cs);
            string dbName = builder.InitialCatalog;
            builder.InitialCatalog = "master";

            using (SqlConnection con = new SqlConnection(builder.ConnectionString))
            {
                con.Open();
                using (SqlCommand cmd = new SqlCommand(
                    "IF DB_ID(@db) IS NULL EXEC('CREATE DATABASE [' + @db + ']')", con))
                {
                    cmd.Parameters.AddWithValue("@db", dbName);
                    cmd.ExecuteNonQuery();
                }
            }

            builder.InitialCatalog = dbName;
            using (SqlConnection con = new SqlConnection(builder.ConnectionString))
            using (SqlCommand cmd = new SqlCommand(@"
                IF OBJECT_ID('dbo.Products') IS NULL
                BEGIN
                    CREATE TABLE dbo.Products (
                        ProductID   INT IDENTITY(1,1) PRIMARY KEY,
                        ProductName NVARCHAR(100) NOT NULL,
                        Category    NVARCHAR(100) NULL,
                        Quantity    INT NOT NULL,
                        Price       DECIMAL(10,2) NOT NULL
                    );
                    INSERT INTO dbo.Products (ProductName, Category, Quantity, Price) VALUES
                        ('Laptop',   'Electronics', 10, 55000),
                        ('Mouse',    'Accessories',  3,   500),
                        ('Keyboard', 'Accessories', 25,  1200);
                END", con))
            {
                con.Open();
                cmd.ExecuteNonQuery();
            }

            dbReady = true;
        }

        protected void Page_Load(object sender, EventArgs e)
        {
            try
            {
                EnsureDatabase();
            }
            catch (SqlException ex)
            {
                ShowMessage("Could not set up database on '"
                    + new SqlConnectionStringBuilder(cs).DataSource + "': " + ex.Message, false);
                return;
            }

            if (!IsPostBack)
            {
                LoadProducts();
            }
        }

        void ShowMessage(string text, bool success)
        {
            lblMessage.Text = text;
            lblMessage.ForeColor = success
                ? System.Drawing.Color.Green
                : System.Drawing.Color.Red;
        }

        void LoadProducts()
        {
            try
            {
                using (SqlConnection con = new SqlConnection(cs))
                using (SqlDataAdapter da = new SqlDataAdapter(
                    "SELECT ProductID, ProductName, Category, Quantity, Price " +
                    "FROM Products ORDER BY ProductID", con))
                {
                    DataTable dt = new DataTable();
                    da.Fill(dt);
                    gvProducts.DataSource = dt;
                    gvProducts.DataBind();

                    ShowMessage("Loaded " + dt.Rows.Count + " product(s) from "
                        + con.DataSource + " / " + con.Database, dt.Rows.Count > 0);
                }
            }
            catch (SqlException ex)
            {
                ShowMessage("Database error: " + ex.Message, false);
            }
        }

        // Validates the form fields; returns false and shows a message if invalid.
        bool TryReadInputs(out string name, out string category,
                           out int qty, out decimal price)
        {
            name = txtProductName.Text.Trim();
            category = txtCategory.Text.Trim();
            qty = 0;
            price = 0;

            if (name == "")
            {
                ShowMessage("Product name is required.", false);
                return false;
            }
            if (!int.TryParse(txtQuantity.Text, NumberStyles.Integer,
                    CultureInfo.InvariantCulture, out qty) || qty < 0)
            {
                ShowMessage("Enter a valid quantity (0 or more).", false);
                return false;
            }
            if (!decimal.TryParse(txtPrice.Text, NumberStyles.Number,
                    CultureInfo.InvariantCulture, out price) || price < 0)
            {
                ShowMessage("Enter a valid price (0 or more).", false);
                return false;
            }
            return true;
        }

        bool TryReadId(out int id)
        {
            if (!int.TryParse(txtProductID.Text, out id))
            {
                ShowMessage("Select a product from the table first.", false);
                return false;
            }
            return true;
        }

        protected void btnInsert_Click(object sender, EventArgs e)
        {
            if (!TryReadInputs(out string name, out string category,
                               out int qty, out decimal price))
                return;

            try
            {
                using (SqlConnection con = new SqlConnection(cs))
                using (SqlCommand cmd = new SqlCommand(
                    @"INSERT INTO Products (ProductName, Category, Quantity, Price)
                      VALUES (@name, @category, @qty, @price)", con))
                {
                    cmd.Parameters.AddWithValue("@name", name);
                    cmd.Parameters.AddWithValue("@category", category);
                    cmd.Parameters.AddWithValue("@qty", qty);
                    cmd.Parameters.AddWithValue("@price", price);

                    con.Open();
                    cmd.ExecuteNonQuery();
                }

                ShowMessage("Product added successfully.", true);
                ClearFields();
            }
            catch (SqlException ex)
            {
                ShowMessage("Database error: " + ex.Message, false);
            }
            LoadProducts();
        }

        protected void btnUpdate_Click(object sender, EventArgs e)
        {
            if (!TryReadId(out int id)) return;
            if (!TryReadInputs(out string name, out string category,
                               out int qty, out decimal price))
                return;

            try
            {
                int rows;
                using (SqlConnection con = new SqlConnection(cs))
                using (SqlCommand cmd = new SqlCommand(
                    @"UPDATE Products SET
                        ProductName=@name, Category=@category,
                        Quantity=@qty, Price=@price
                      WHERE ProductID=@id", con))
                {
                    cmd.Parameters.AddWithValue("@id", id);
                    cmd.Parameters.AddWithValue("@name", name);
                    cmd.Parameters.AddWithValue("@category", category);
                    cmd.Parameters.AddWithValue("@qty", qty);
                    cmd.Parameters.AddWithValue("@price", price);

                    con.Open();
                    rows = cmd.ExecuteNonQuery();
                }

                if (rows > 0)
                {
                    ShowMessage("Product updated successfully.", true);
                    ClearFields();
                }
                else
                {
                    ShowMessage("Product not found.", false);
                }
            }
            catch (SqlException ex)
            {
                ShowMessage("Database error: " + ex.Message, false);
            }
            LoadProducts();
        }

        protected void btnDelete_Click(object sender, EventArgs e)
        {
            if (!TryReadId(out int id)) return;

            try
            {
                int rows;
                using (SqlConnection con = new SqlConnection(cs))
                using (SqlCommand cmd = new SqlCommand(
                    "DELETE FROM Products WHERE ProductID=@id", con))
                {
                    cmd.Parameters.AddWithValue("@id", id);
                    con.Open();
                    rows = cmd.ExecuteNonQuery();
                }

                if (rows > 0)
                {
                    ShowMessage("Product deleted successfully.", true);
                    ClearFields();
                }
                else
                {
                    ShowMessage("Product not found.", false);
                }
            }
            catch (SqlException ex)
            {
                ShowMessage("Database error: " + ex.Message, false);
            }
            LoadProducts();
        }

        protected void btnClear_Click(object sender, EventArgs e)
        {
            ClearFields();
            // Clear the visible message and report success for debugging
            ShowMessage("", true);
        }

        void ClearFields()
        {
            txtProductID.Text = "";
            txtProductName.Text = "";
            txtCategory.Text = "";
            txtQuantity.Text = "";
            txtPrice.Text = "";
        }

        protected void gvProducts_SelectedIndexChanged(object sender, EventArgs e)
        {
            try
            {
                if (gvProducts.SelectedDataKey == null)
                {
                    ShowMessage("No product selected.", false);
                    return;
                }

                txtProductID.Text = gvProducts.SelectedDataKey.Value.ToString();

                var row = gvProducts.SelectedRow;
                // Cells: 0=Select,1=ProductID,2=ProductName,3=Category,4=Quantity,5=Price
                txtProductName.Text = HttpUtility.HtmlDecode(row.Cells[2].Text);
                txtCategory.Text = HttpUtility.HtmlDecode(row.Cells[3].Text)
                    .Replace("\u00a0", "");   // empty cells render as &nbsp;
                txtQuantity.Text = row.Cells[4].Text;
                txtPrice.Text = row.Cells[5].Text;

                ShowMessage("Product selected for editing.", true);
            }
            catch (Exception ex)
            {
                ShowMessage("Error selecting product: " + ex.Message, false);
            }
        }
    }
}

