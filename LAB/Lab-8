-- Setup script for (localdb)\MSSQLLocalDB. Run in Visual Studio: SQL Server Object Explorer -> (localdb)\MSSQLLocalDB -> New Query
IF DB_ID('InventoryDB') IS NULL
    CREATE DATABASE InventoryDB;
GO

USE InventoryDB;
GO

IF OBJECT_ID('dbo.Products') IS NOT NULL
    DROP TABLE dbo.Products;
GO

CREATE TABLE dbo.Products (
    ProductID   INT IDENTITY(1,1) PRIMARY KEY,
    ProductName NVARCHAR(100) NOT NULL,
    Category    NVARCHAR(100) NULL,
    Quantity    INT NOT NULL,
    Price       DECIMAL(10,2) NOT NULL
);
GO

INSERT INTO dbo.Products (ProductName, Category, Quantity, Price) VALUES
('Laptop',   'Electronics', 10, 55000),
('Mouse',    'Accessories',  3,   500),
('Keyboard', 'Accessories', 25,  1200);
GO

SELECT ProductID, ProductName, Category, Quantity, Price
FROM dbo.Products
ORDER BY ProductID;
