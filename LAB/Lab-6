@model IEnumerable<ProductCatalog.Models.Product>

@{
    ViewBag.Title = "Products";
}

<style>
    .pc-grid { display: flex; gap: 18px; flex-wrap: wrap; }
    .pc-col { flex: 0 0 calc(50% - 9px); box-sizing: border-box; }
    .pc-card { border: 1px solid #eee; border-radius: 8px; padding: 18px; background: #fff;
               box-shadow: 0 6px 18px rgba(0,0,0,0.05); height: 100%; box-sizing: border-box;
               transition: transform .15s ease, box-shadow .15s ease; }
    .pc-card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0,0,0,0.09); }
    .pc-img { height: 190px; border-radius: 6px; overflow: hidden; margin-bottom: 12px; background: #f8fafc; }
    .pc-img a, .pc-img svg, .pc-img img { display: block; width: 100%; height: 100%; }
    .pc-img img { object-fit: contain; padding: 8px; box-sizing: border-box; }
    @@media (max-width: 700px) { .pc-col { flex: 0 0 100%; } }
</style>

<div class="container" style="max-width:1100px; margin-top:18px;">
    <div style="background:#29527a; color:#fff; padding:22px; text-align:center; margin-bottom:18px;">
        <h1 style="margin:0; font-weight:600;">Product Catalog</h1>
        <div style="font-size:0.95rem; opacity:0.9;">Available Products</div>
    </div>

    <div class="pc-grid">
        @foreach (var item in Model)
        {
            <div class="pc-col">
                <div class="pc-card">
                    <h3 style="color:#2b5f91; margin-top:0;">@item.ProductName</h3>
                    <div style="color:#6c757d; font-size:0.95rem; margin-bottom:8px;">Category: @item.Category</div>
                    <p style="color:#444; margin-bottom:12px;">@item.Description</p>

                    <div class="pc-img">
                        <a href="@Url.Action("Details", "Product", new { id = item.ProductId })">
                            @if (!string.IsNullOrEmpty(item.ImageSvg))
                            {
                                @Html.Raw(item.ImageSvg)
                            }
                            else if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@Url.Content(item.ImageUrl)" alt="@item.ProductName" />
                            }
                        </a>
                    </div>

                    <div style="color:#198754; font-weight:700; margin-bottom:10px;">&#8377; @item.Price.ToString("N0")</div>
                    <a href="@Url.Action("Details", "Product", new { id = item.ProductId })" class="btn btn-primary">View Details</a>
                </div>
            </div>
        }
    </div>
</div>

