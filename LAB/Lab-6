using System.Collections.Generic;
using System.Linq;
using System.Web.Mvc;
using ProductCatalog.Models;

namespace ProductCatalog.Controllers
{
    public class ProductController : Controller
    {
        // GET: Product
        public ActionResult Index()
        {
            return View(GetSampleProducts());
        }

        // GET: Product/Details/201
        public ActionResult Details(int? id)
        {
            if (!id.HasValue)
            {
                return RedirectToAction("Index");
            }

            var product = GetSampleProducts().FirstOrDefault(p => p.ProductId == id.Value);
            if (product == null)
            {
                return HttpNotFound();
            }

            return View(product);
        }

        private List<Product> GetSampleProducts()
        {
            return new List<Product>
            {
                new Product
                {
                    ProductId = 201,
                    ProductName = "Laptop Pro 15",
                    Description = "High performance laptop with latest CPU and SSD storage.",
                    Price = 55000m,
                    Category = "Electronics",
                    ImageSvg = ProductImages.Laptop
                },
                new Product
                {
                    ProductId = 202,
                    ProductName = "Smartphone X",
                    Description = "Modern smartphone with excellent camera and battery life.",
                    Price = 25000m,
                    Category = "Electronics",
                    ImageSvg = ProductImages.Phone
                },
                new Product
                {
                    ProductId = 203,
                    ProductName = "Noise-Cancelling Headphones",
                    Description = "Over-ear wireless headphones with active noise cancellation.",
                    Price = 2500m,
                    Category = "Accessories",
                    ImageSvg = ProductImages.Headphones
                }
            };
        }
    }
}

