@model ProductCatalog.Models.Product

@{
    ViewBag.Title = Model.ProductName;
}

<style>
    /* Modern detail layout: large image on the left, info on the right */
    .modern-container { max-width:1100px; margin:22px auto; padding:0 12px; }
    .modern-card { display:flex; gap:28px; align-items:flex-start; background:#fff; border-radius:10px; box-shadow:0 12px 30px rgba(31,41,55,0.06); padding:20px; }
    .modern-media { flex:0 0 520px; border-radius:10px; overflow:hidden; background:#f8fafc; display:flex; align-items:center; justify-content:center; }
    .modern-media img, .modern-media svg { width:100%; height:100%; display:block; }
    .modern-info { flex:1; min-width:280px; }
    .pc-breadcrumb { color:#6b7280; margin-bottom:10px; display:block; }
    .product-title { color:#0b3a66; font-size:1.8rem; margin:0 0 8px 0; }
    .product-category { color:#64748b; margin-bottom:10px; }
    .product-description { color:#334155; line-height:1.5; margin-bottom:18px; }
    .price { color:#0f5132; font-weight:800; font-size:1.6rem; margin-bottom:18px; }
    .primary-cta { background:#0d6efd; color:#fff; padding:12px 18px; border-radius:8px; text-decoration:none; display:inline-block; box-shadow:0 6px 18px rgba(13,110,253,0.12); }
    .secondary-cta { background:transparent; color:#0b3a66; border:1px solid #dfe7ef; padding:10px 14px; border-radius:8px; text-decoration:none; margin-left:10px; }
    @@media (max-width: 900px) { .modern-card { flex-direction:column; } .modern-media { flex:0 0 auto; height:320px; } }
</style>

<div class="modern-container">
    <a class="pc-breadcrumb" href="@Url.Action("Index","Product")">&larr; Back to catalog</a>

    <div class="modern-card">
        <div class="modern-media">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Url.Content(Model.ImageUrl)" alt="@Model.ProductName" style="object-fit:cover; max-height:520px;" />
            }
            else if (!string.IsNullOrEmpty(Model.ImageSvg))
            {
                <div style="width:100%; height:100%;">@Html.Raw(Model.ImageSvg)</div>
            }
            else
            {
                <div style="width:100%; height:320px; display:flex; align-items:center; justify-content:center; color:#9ca3af;">No image available</div>
            }
        </div>

        <div class="modern-info">
            <h1 class="product-title">@Model.ProductName</h1>
            <div class="product-category">Category: <strong>@Model.Category</strong></div>
            <div class="product-description">@Model.Description</div>

            <div class="price">&#8377; @Model.Price.ToString("N0")</div>

            <div>
                <a href="#" class="primary-cta">Add to cart</a>
                <a href="#" class="secondary-cta">Buy now</a>
            </div>
        </div>
    </div>
</div>
